{% extends 'base.html.twig' %}

{% block title %}Hello HolidayController!{% endblock %}

{% block body %}
    {% if is_granted('ROLE_EMPLOYEE') %}
        <p>Email : {{ app.user.email }}</p>
    {% endif %}

    <div data-controller="calendar" data-user={{ app.user.email}} data-holidays='{{ publicHolidays|json_encode|raw }}'>
        <div id='calendar'></div>

        <!-- Modal should be a direct child of the controller element -->
        {{ include('_modal.html.twig') }}
    </div>
{% endblock %}
